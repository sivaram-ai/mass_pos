<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.masspos</groupId>
    <artifactId>mass-pos</artifactId>
    <!-- The till's version: shown at the top of the Settings screen, and what
         tools/build-installer.ps1 gives jpackage as the installer's app version. Bump it for every
         shipped build, as Windows refuses to install the same app version over itself (error 1638). -->
    <version>0.4.22</version>
    <name>Mass POS</name>
    <description>Offline-first GST billing and inventory POS (single desktop executable)</description>

    <properties>
        <java.version>21</java.version>
        <!-- Overrides the Boot-managed version: newer SQLite engine (RETURNING, better WAL checkpointing). -->
        <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
        <jserialcomm.version>2.11.4</jserialcomm.version>
        <zxing.version>3.5.3</zxing.version>
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
        <node.version>v22.12.0</node.version>
    </properties>

    <dependencies>
        <!-- Embedded Tomcat serves the REST API and the compiled React UI from classpath:/static -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MCA Rule 11(g) audit trail: immutable per-revision snapshots of every audited entity -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-envers</artifactId>
        </dependency>
        <!-- Hibernate 6 ships SQLiteDialect here, not in hibernate-core -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>

        <!-- BCrypt for till PINs. The crypto module alone: no security starter, no filter chain. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Raw ESC/POS over USB-CDC / serial, bypassing the OS print spooler (Phase 2) -->
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>${jserialcomm.version}</version>
        </dependency>

        <!--
            QR codes for the WINDOWS printer type. A thermal printer draws its own from the ESC/POS
            command; a driver printer is sent a picture, so the till has to encode it. Core only:
            the javase artifact would drag in no more than a BufferedImage writer we do not need.
        -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Stable jar name: jpackage references target/mass-pos.jar directly -->
        <finalName>mass-pos</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- A second, plain jar holding only the desktop launcher: the shortcut's exe runs it
                 with a bare classpath, which a Spring Boot fat jar cannot be launched from. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>desktop-launcher</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>launcher</classifier>
                            <includes>
                                <include>com/masspos/desktop/**</include>
                            </includes>
                            <archive>
                                <manifest>
                                    <mainClass>com.masspos.desktop.DesktopLauncher</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>
                    <!--
                        The counter application: a till with no database, no licence and no Spring.
                        It finds the shop's server, opens the billing screen against it, and runs
                        the print agent that drives the printer and drawer on that counter.

                        It takes the hardware classes rather than owning a second copy of ESC/POS -
                        the trickiest code in the product, and the one place a second copy would
                        quietly drift. Only the classes that carry no Spring are listed: the rest
                        of that package is the server's and would never be loaded here anyway.
                    -->
                    <execution>
                        <id>counter-app</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>counter</classifier>
                            <!--
                                Always rebuild. A counter shipped once with a jar that was up to
                                date by the plugin's reckoning and missing setup.html, which is the
                                only screen the program has: the agent threw reading it, the
                                connection closed with no answer, and both machines showed a blank
                                browser error. Rebuilding every time costs under a second.
                            -->
                            <forceCreation>true</forceCreation>
                            <includes>
                                <include>com/masspos/counter/**</include>
                                <include>com/masspos/desktop/Browser*</include>
                                <include>com/masspos/desktop/PosPaths*</include>
                                <include>com/masspos/client/Discovery.class</include>
                                <include>com/masspos/common/IndiaTime*</include>
                                <include>com/masspos/hardware/CodePage*</include>
                                <include>com/masspos/hardware/EscPos*</include>
                                <include>com/masspos/hardware/FilePrinterConnection*</include>
                                <include>com/masspos/hardware/ParcelQr*</include>
                                <include>com/masspos/hardware/PrinterConnection*</include>
                                <include>com/masspos/hardware/PrinterException*</include>
                                <include>com/masspos/hardware/PrinterProperties*</include>
                                <!-- The printer settings screen's own shape: a counter's printer
                                     page is the server's page, saved on the counter instead. -->
                                <include>com/masspos/hardware/PrinterSettingsForm*</include>
                                <include>com/masspos/hardware/PrinterStatus*</include>
                                <include>com/masspos/hardware/ReceiptLayout*</include>
                                <include>com/masspos/hardware/SerialPrinterConnection*</include>
                                <include>com/masspos/hardware/TcpPrinterConnection*</include>
                                <include>com/masspos/hardware/WindowsPrinterConnection*</include>
                            </includes>
                            <archive>
                                <manifest>
                                    <mainClass>com.masspos.counter.CounterApp</mainClass>
                                    <addClasspath>true</addClasspath>
                                    <classpathPrefix>lib/</classpathPrefix>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The handful of jars the counter needs beside its own, for jpackage to bundle. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>counter-libraries</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/counter-lib</outputDirectory>
                            <stripVersion>false</stripVersion>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.fazecast</groupId>
                                    <artifactId>jSerialComm</artifactId>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.google.zxing</groupId>
                                    <artifactId>core</artifactId>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-databind</artifactId>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-core</artifactId>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-annotations</artifactId>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.slf4j</groupId>
                                    <artifactId>slf4j-api</artifactId>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.slf4j</groupId>
                                    <artifactId>slf4j-simple</artifactId>
                                    <version>2.0.17</version>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Builds frontend/ (Vite + React + TS + Tailwind) into src/main/resources/static before the
            jar is packaged. Self-activates once frontend/package.json exists; installs a private Node
            under target/, so build machines need only a JDK.
        -->
        <profile>
            <id>frontend</id>
            <activation>
                <file>
                    <exists>${basedir}/frontend/package.json</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <configuration>
                            <workingDirectory>frontend</workingDirectory>
                            <installDirectory>target</installDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-node-and-npm</id>
                                <goals>
                                    <goal>install-node-and-npm</goal>
                                </goals>
                                <configuration>
                                    <nodeVersion>${node.version}</nodeVersion>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-ci</id>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>ci</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-build</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>run build</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
